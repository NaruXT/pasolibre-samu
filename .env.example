# Portal (useportal.co) — see docs/agents/issue-tracker.md and CLAUDE.md's Intent Layer.
# Server-side: project's secret key (sk_...), used as `Authorization: Bearer <PORTAL_SECRET>`
# for REST publishes to Portal channels. Never exposed to the client.
PORTAL_SECRET=sk_...

# Client-side: publishable key (pk_...), safe to ship in the browser bundle.
NEXT_PUBLIC_PORTAL_API_KEY=pk_...

# Mapbox GL JS access token, safe to ship in the browser bundle.
NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# Anthropic API key for the tick-orchestration agent (ticket #8), read by @ai-sdk/anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model id for the tick agent (Vercel AI SDK model string). Defaults to claude-opus-5.
# TICK_AGENT_MODEL=claude-haiku-4-5
